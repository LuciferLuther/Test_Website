{
  "name": "japan-slowly",
  "version": "1.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:install": "npx impeccable install",
    "design:detect": "npx impeccable detect app components",
    "design:detect:json": "npx impeccable detect --json app components",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build",
    "quality": "npm run verify && npm run design:detect"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "motion": "12.43.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "typescript": "5.8.3"
  }
}
